# ==============================================================================
# Smart Resume Shortlisting System - Local Environment Configuration
# Copy this file to .env (or backend/.env) and update with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Local MySQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/smart_resume_db

# Option B: Individual Database Parameters (Used if DATABASE_URL is not set)
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_resume_db

# Note: The database 'smart_resume_db' will be created automatically on startup
# if it does not already exist on your local MySQL server.
# For local SQLite fallback testing only, you can use: DATABASE_URL=sqlite:///smart_resume_db.db

# ------------------------------------------------------------------------------
# 2. Flask & JWT Security Keys
# ------------------------------------------------------------------------------
SECRET_KEY=shortlistiq-secret-flask-key-change-in-production
JWT_SECRET_KEY=shortlistiq-jwt-secret-key-change-in-production
PORT=5000

# ------------------------------------------------------------------------------
# 3. Brevo Transactional Email API Configuration
# ------------------------------------------------------------------------------
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=shortlistiq.official@gmail.com
BREVO_SENDER_NAME=ShortlistIQ

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. File Uploads Directory (Resolved automatically to backend/uploads)
# ------------------------------------------------------------------------------
UPLOAD_FOLDER=./uploads
